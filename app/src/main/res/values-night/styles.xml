<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="App.BaseTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">#272727</item>
        <item name="android:navigationBarColor">?colorSurface</item>
    </style>

    <!-- Theme.Termux.AppBase 暗色覆盖：状态栏颜色取 hyper_surface(#1C1B1F)，图标白色 -->
    <style name="Theme.Termux.AppBase" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/hyper_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>

    <!-- HyperCeiler-style About page theme (dark override) -->
    <style name="Theme.Termux.About" parent="@style/Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#1C1B1F</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>
