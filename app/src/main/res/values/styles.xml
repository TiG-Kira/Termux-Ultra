<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="Theme.Termux" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <!-- 两栏设为全透明。windowBackground 是黑色，所以「非边到边」的旧页面
             透出黑色，与原先的 #000000 视觉等价；边到边的页面则真正透出内容。 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">#FF000000</item>
        <item name="android:windowBackground">@android:color/black</item>

        <!-- Seen in buttons on left drawer: -->
        <item name="colorAccent">#212121</item>
        <item name="alertDialogTheme">@style/TermuxAlertDialogStyle</item>
        <!-- Avoid action mode toolbar pushing down terminal content when
             selecting text on pre-6.0 (non-floating toolbar). -->
        <item name="android:windowActionModeOverlay">true</item>

        <!-- 已移除 windowTranslucentStatus / windowTranslucentNavigation（API 19 遗留标志）。
             这两个标志会让系统无视 statusBarColor / navigationBarColor，在状态栏与导航栏
             强行盖一层半透明蒙版（各 ROM 深浅不一，观感脏）。
             边到边改由各 Activity 的 WindowCompat.setDecorFitsSystemWindows(window, false) 负责，
             布局行为不变，只是不再有蒙版。 -->
        <!-- Android 10 (API 29) 起，栏色透明时系统会自动补一层半透明底色以保证图标对比度。
             边到边页面正是把栏色设成透明，所以必须显式关掉，否则蒙版换个来源又回来了。 -->
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>

        <!-- https://developer.android.com/training/tv/start/start.html#transition-color -->
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
    </style>


    <!-- See https://developer.android.com/training/material/theme.html for how to customize the Material theme. -->
    <!-- NOTE: Cannot use "Light." since it hides the terminal scrollbar on the default black background. -->
    <style name="Theme.Termux.Black" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorPrimary">#FF000000</item>
        <item name="android:windowBackground">@android:color/black</item>

        <!-- Seen in buttons on left drawer: -->
        <item name="android:colorAccent">#FDFDFD</item>
        <!-- Avoid action mode toolbar pushing down terminal content when
             selecting text on pre-6.0 (non-floating toolbar). -->
        <item name="android:windowActionModeOverlay">true</item>

        <!-- 同 Theme.Termux：移除 windowTranslucentStatus / windowTranslucentNavigation，
             并关掉 Android 10+ 的对比度自动补色。 -->
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>

        <!-- https://developer.android.com/training/tv/start/start.html#transition-color -->
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
    </style>


    <style name="TermuxAlertDialogStyle" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <!-- Seen in buttons on alert dialog: -->
        <item name="android:colorAccent">#212121</item>
    </style>

    <!-- 冷启动专用主题。继承 framework 原生主题（非 AppCompat），避免 SplashActivity 触发 AppCompat 初始化。
         windowBackground 使用 HyperCeiler-style surface 色，跟随亮/暗模式，
         与 OOBE / MainActivity 的首帧 windowBackground 对齐，消除启动视觉跳跃。 -->
    <style name="Theme.Termux.Splash" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@color/hyper_surface</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- OOBE 页窗口主题。仅覆盖 windowBackground 为 DayNight surface；
         两栏透明与无蒙版由父类 Theme.Termux 统一处理，
         延伸到状态栏由 OobeActivity 的 setDecorFitsSystemWindows(false) 负责。 -->
    <style name="Theme.Termux.Oobe" parent="@style/Theme.Termux">
        <item name="android:windowBackground">@color/hyper_surface</item>
    </style>

    <!-- 主页窗口主题。
         全透明两栏 + 无半透明蒙版已由父类 Theme.Termux 统一处理，这里只覆盖 windowBackground。
         状态栏/导航栏图标的明暗由 KiTerminalTheme 按亮暗模式动态设置。 -->
    <style name="Theme.Termux.Main" parent="@style/Theme.Termux">
        <item name="android:windowBackground">@color/hyper_surface</item>
    </style>

    <style name="Theme.Termux.Transparent" parent="@style/Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <!-- HyperCeiler-style About page theme. DayNight so light/dark both correct. -->
    <style name="Theme.Termux.About" parent="@style/Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#F7F7F7</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>
